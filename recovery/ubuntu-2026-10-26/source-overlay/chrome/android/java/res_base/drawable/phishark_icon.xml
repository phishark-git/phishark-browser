    <item><shape android:shape="rectangle"><solid android:color="#092330" /></shape></item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <bitmap android:src="@drawable/phishark_mark" android:gravity="fill" />
    </item>
</layer-list>
